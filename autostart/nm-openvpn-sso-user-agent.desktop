[Desktop Entry]
Type=Application
Name=NetworkManager OpenVPN SSO User Agent
Comment=Listens for OpenVPN SSO authentication URLs and opens the default browser
Exec=/run/current-system/sw/bin/nm-openvpn-sso-user-agent
Icon=network-vpn
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
Hidden=true
