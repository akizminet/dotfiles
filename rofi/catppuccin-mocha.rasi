* {
    bg-col:           #1e1e2e;
    bg-col-light:     #1e1e2e;
    border-col:       #89b4fa;
    selected-col:     #313244;
    blue:             #89b4fa;
    fg-col:           #cdd6f4;
    fg-col2:          #f38ba8;
    grey:             #6c7086;

    width:            600;
    font:             "Noto Sans Mono 11";
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height:           380px;
    border:           2px;
    border-color:     @border-col;
    background-color: @bg-col;
    border-radius:    10px;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    children:         [prompt, entry];
    background-color: @bg-col;
    border-radius:    6px;
    padding:          2px;
}

prompt {
    background-color: @blue;
    padding:          6px 12px;
    text-color:       @bg-col;
    border-radius:    6px;
    margin:           10px 0px 0px 10px;
}

entry {
    padding:          6px 12px;
    margin:           10px 10px 0px 10px;
    text-color:       @fg-col;
    background-color: @selected-col;
    border-radius:    6px;
    placeholder:      "Search...";
    placeholder-color: @grey;
}

listview {
    border:           0px 0px 0px;
    padding:          6px 0px 0px;
    margin:           10px 10px 10px 10px;
    columns:          1;
    lines:            7;
    background-color: @bg-col;
}

element {
    padding:          8px 12px;
    background-color: @bg-col;
    text-color:       @fg-col;
    border-radius:    6px;
}

element-icon {
    size:             24px;
    margin:           0px 8px 0px 0px;
}

element selected {
    background-color: @selected-col;
    text-color:       @blue;
}

mode-switcher {
    spacing:          0;
}

button {
    padding:          10px;
    background-color: @bg-col-light;
    text-color:       @grey;
    vertical-align:   0.5; 
    horizontal-align: 0.5;
}

button selected {
    background-color: @bg-col;
    text-color:       @blue;
}
