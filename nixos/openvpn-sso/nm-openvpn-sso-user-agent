#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# NetworkManager OpenVPN SSO Plugin User Agent

import sys
import os
import shutil
import subprocess
from gi.repository import Gio, GLib

def launch_browser(url):
    # Strategy 1: If inside Distrobox, invoke host's gio open or xdg-open via distrobox-host-exec
    if shutil.which("distrobox-host-exec"):
        for cmd in [["distrobox-host-exec", "gio", "open", url], ["distrobox-host-exec", "xdg-open", url]]:
            try:
                subprocess.Popen(cmd)
                print(f"[UserAgent] Successfully launched on host via: {' '.join(cmd)}", flush=True)
                return
            except Exception as e:
                print(f"[UserAgent] Failed host execution {' '.join(cmd)}: {e}", flush=True)

    # Strategy 2: Direct system xdg-open or gio open
    for cmd in [["xdg-open", url], ["gio", "open", url]]:
        try:
            subprocess.Popen(cmd)
            print(f"[UserAgent] Successfully launched via: {' '.join(cmd)}", flush=True)
            return
        except Exception as e:
            print(f"[UserAgent] Failed launching {' '.join(cmd)}: {e}", flush=True)

def on_signal(connection, sender_name, object_path, interface_name, signal_name, parameters, user_data):
    if signal_name == "SsoUrl":
        try:
            url = parameters.unpack()[0]
            print(f"[UserAgent] Received SSO URL: {url}", flush=True)
            launch_browser(url)
        except Exception as e:
            print(f"[UserAgent] Failed to handle SSO URL: {e}", flush=True)

def main():
    print("[UserAgent] Starting NetworkManager OpenVPN SSO User Agent...", flush=True)
    try:
        conn = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    except Exception as e:
        print(f"[UserAgent] Failed to connect to system D-Bus: {e}", flush=True)
        sys.exit(1)

    print("[UserAgent] Connected to system D-Bus. Subscribing to SsoUrl signal...", flush=True)
    conn.signal_subscribe(
        "org.freedesktop.NetworkManager.openvpn-sso",
        "org.freedesktop.NetworkManager.VPN.Plugin",
        "SsoUrl",
        "/org/freedesktop/NetworkManager/VPN/Plugin",
        None,
        Gio.DBusSignalFlags.NONE,
        on_signal,
        None
    )

    loop = GLib.MainLoop()
    try:
        loop.run()
    except KeyboardInterrupt:
        print("[UserAgent] Exiting...", flush=True)

if __name__ == "__main__":
    main()
